{
  "llm": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "timeout": 60,
    "max_tokens": 4096
  },
  "routes": {
    "light": "deepseek-chat",
    "heavy": "deepseek-reasoner"
  },
  "vault_root": "C:/path/to/your/obsidian-vault",
  "brain": {
    "config_path": "../../obsidian_agent_brain/config.json"
  },
  "memory": {
    "dir": "C:/path/to/your/obsidian-vault/.agent-brain/memory",
    "dedupe": true
  },
  "skills_dir": "skills",
  "trace_dir": "logs/trace",
  "limits": {
    "max_steps": 15,
    "timeout": 300,
    "context_budget": 600000,
    "max_tool_result_chars": 4000,
    "max_tool_calls": 40,
    "tool_call_nudge": 0.6,
    "memorize_every": 5,
    "memory_inject_topk": 5
  },
  "resilience": {
    "max_retries": 2,
    "backoff": 1.0,
    "breaker_threshold": 5,
    "breaker_recovery": 30.0
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 8643,
    "token": "",
    "approval_timeout_seconds": 120
  },
  "approval_mode": "risk_based",
  "danger_allowlist": [],
  "rag": {
    "vector_enabled": true,
    "embed_base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "embed_model": "text-embedding-v4",
    "embed_api_key": ""
  },
  "agents": {
    "_comment": "max_parallel_consults 超出名单进 summary.skipped；consult_result_max_chars 超限正文截断并归档 session range",
    "max_parallel_consults": 3,
    "consult_result_max_chars": 6000,
    "external": [
      {
        "name": "claude-code",
        "command": "claude-code-acp",
        "args": [],
        "cwd": "",
        "env": {},
        "timeout": 300.0
      }
    ]
  }
}
